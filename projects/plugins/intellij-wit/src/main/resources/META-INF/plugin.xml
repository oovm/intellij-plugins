<idea-plugin>
	<id>wit</id>
	<name>WIT IDL</name>
	<vendor>Bytecode Alliance</vendor>
	<depends>com.intellij.modules.platform</depends>
	<resource-bundle>messages.WitBundle</resource-bundle>
	<extensions defaultExtensionNs="com.intellij">
		<fileType
			name="WIT"
			language="WIT"
			extensions="wit;witx"
			implementationClass="com.github.bytecodealliance.wit.language.file.WitFileType"
			fieldName="INSTANCE"
		/>
		<lang.parserDefinition
			language="WIT"
			implementationClass="com.github.bytecodealliance.wit.language.psi.WitParserDefinition"
		/>
		<additionalTextAttributes scheme="Default" file="colors/WitDefault.xml"/>
		<additionalTextAttributes scheme="Darcula" file="colors/WitDarcula.xml"/>
		<colorSettingsPage implementation="com.github.bytecodealliance.wit.ide.highlight.WitHighlightSetting"/>
		<lang.syntaxHighlighter
			language="WIT"
			implementationClass="com.github.bytecodealliance.wit.ide.highlight.WitSyntaxHighlighter"
		/>
		<lang.commenter
			language="WIT"
			implementationClass="com.github.bytecodealliance.wit.ide.comment.WitCommenter"
		/>
		<lang.braceMatcher
			language="WIT"
			implementationClass="com.github.bytecodealliance.wit.ide.matcher.WitBraceMatcher"
		/>
	</extensions>
</idea-plugin>
