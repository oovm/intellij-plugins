// Yggdrasil 语法词法测试

// 关键字测试
grammar TestGrammar {
    file: '*.test'
}

// 类声明
class TestClass {
    '{' '}'
}

// 联合声明
union TestUnion {
    | TestClass
}

// 原子类
atomic class TestAtomic {
    /[a-z]+/
}

// 忽略规则
ignore class WhiteSpace {
    [\p{WhiteSpace}]
}

// 注释测试
// 单行注释
/* 多行
注释 */

// 字符串测试
class TestString {
    "test"
    'test'
}

// 数字测试
atomic class TestNumber {
    /[0-9]+/
}

// 标识符测试
class TestIdentifier {
    /[a-zA-Z_][a-zA-Z0-9_]*/
}

// 修饰符测试
@style(string)
class TestStyledClass {
    "test"
}

// 宏调用测试
class TestMacroCall {
    @comment_line('//')
}

// 导入语句测试
class TestImport {
    import "test" as Test
    import "test" { TestItem }
}

class TestItem {
    TestIdentifier as TestIdentifier
}
